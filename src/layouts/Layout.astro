---
import '../styles/normalize.css';
import '../styles/index.css';

type Props = {
  title?: string
}

const title = Astro.props.title ? `kinect-stretch - ${Astro.props.title}` : 'kinect-stretch';

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body>
		<slot/>
	</body>
</html>
